# Discord Bot Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_TOKEN=your_discord_token_here

# Database Configuration (if needed)
DATABASE_URL=your_database_url_here

# Important Channels & Other features
ERROR_LOG_CHANNEL_ID=channel_id_here

# Environment
NODE_ENV=development

# Comma-separated guild IDs: in non-production, slash commands register only to these guilds (faster iteration)
# DEV_GUILD_IDS=123456789012345678,987654321098765432

# Comma-separated Discord user IDs: bot developer privileges (owner commands, non-RSO link in development only)
# BOT_DEV_IDS=501700626690998280

# Verbose API / integration logs (1, true, yes, on)
# DEBUG_MODE=1

# Riot Sign-On (required for /riot link in production — VALORANT policy)
# RIOT_CLIENT_ID=your_rso_client_id
# RIOT_CLIENT_SECRET=your_rso_client_secret
# RIOT_API_KEY=optional_alias_for_client_secret
# RIOT_REDIRECT_URI=https://your.domain/riot/callback
# RIOT_LINK_BIND_HOST=0.0.0.0

# HenrikDev (Premier roster lookup only — not for production account linking)
# VAL_API_KEY=your_henrikdev_api_key

# Non-RSO linking (/riot link-backup, /riot link-verify): development only, never in production
# ALLOW_NON_RSO_LINK=true

# MAINTENANCE_MODE=false
# MAINTENANCE_COMMANDS=
