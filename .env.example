# Discord Bot Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_TOKEN=your_discord_token_here

# Database Configuration (if needed)
DATABASE_URL=your_database_url_here

# Important Channels & Other features
ERROR_LOG_CHANNEL_ID=channel_id_here

# Environment
NODE_ENV=development

# Comma-separated guild IDs: in non-production, slash commands register only to these guilds (faster iteration)
# DEV_GUILD_IDS=123456789012345678,987654321098765432

# Comma-separated Discord user IDs: can use privileged commands (e.g. /riot link-backup) without Administrator
# BOT_DEV_IDS=501700626690998280

# Verbose API / integration logs (1, true, yes, on)
# DEBUG_MODE=1

# HenrikDev API key used by Riot backup linking and Premier team/roster lookups
# VAL_API_KEY=your_henrikdev_api_key_here

# Riot Sign-On OAuth settings. The callback server uses the port and path from RIOT_REDIRECT_URI.
# RIOT_CLIENT_ID=your_riot_oauth_client_id_here
# RIOT_CLIENT_SECRET=your_riot_oauth_client_secret_here
# RIOT_API_KEY=optional_riot_client_secret_fallback
# RIOT_REDIRECT_URI=https://your-public-host.example.com/riot/callback
# RIOT_LINK_BIND_HOST=0.0.0.0

# Maintenance mode. Global accepts 1, true, yes, or on; commands are comma-separated IDs.
# MAINTENANCE_MODE=0
# MAINTENANCE_COMMANDS=riot.link,riot.link-backup,riot.link-verify
