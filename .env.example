# Discord
DISCORD_TOKEN=your_discord_token_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Optional: channel that receives error reports as embeds
ERROR_LOG_CHANNEL_ID=

# development | production. Anything but production registers commands per guild via DEV_GUILD_IDS
NODE_ENV=development

# Comma-separated guild IDs: in non-production, slash commands register only to these guilds (faster iteration)
# DEV_GUILD_IDS=123456789012345678,987654321098765432

# Comma-separated Discord user IDs: can use privileged commands (e.g. /riot link-backup) without Administrator
# BOT_DEV_IDS=501700626690998280

# Verbose API / integration logs (1, true, yes, on)
# DEBUG_MODE=1

# Riot Sign-On (RSO) linking: all three are needed, otherwise /riot link is unavailable.
# RIOT_CLIENT_SECRET falls back to RIOT_API_KEY when unset.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
# RIOT_API_KEY=
# Public callback URL registered with Riot; the built-in server answers on its path
RIOT_REDIRECT_URI=https://premier.example.com/riot/callback
# Port the callback server listens on (behind a reverse proxy: the panel's allocated port).
# Defaults to the port in RIOT_REDIRECT_URI
# RIOT_LINK_PORT=25570
# Interface the RSO callback server binds to (default 0.0.0.0)
# RIOT_LINK_BIND_HOST=0.0.0.0

# HenrikDev Valorant API key: sent with Premier lookups when set; required for /riot link-backup
VAL_API_KEY=

# Maintenance: MAINTENANCE_MODE=1 pauses every command that checks it;
# MAINTENANCE_COMMANDS pauses only the listed ones (comma-separated, e.g. riot.link,riot.link-backup)
# MAINTENANCE_MODE=0
# MAINTENANCE_COMMANDS=
