generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  discordId String   @unique
  username  String
  language  String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riotPuuid     String?   @unique
  riotGameName  String?
  riotTagLine   String?
  riotLinkedAt  DateTime?

  teamMemberships TeamMember[]
  leader          Team[]       @relation("TeamLeader")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  teamTag   String   @default("")
  guildId   String
  leader    User?    @relation("TeamLeader", fields: [leaderId], references: [discordId])
  leaderId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberLinks TeamMember[]

  @@index([guildId])
  @@unique([name, teamTag])
}

/// Explicit join: one row per user on a team’s roster (readable in SQL tools: teamId + userId + FKs).
model TeamMember {
  id     String @id @default(uuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}
